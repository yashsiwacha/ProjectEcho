# Copy to .env and replace all development-only placeholder values before running Compose.
POSTGRES_DB=projectecho
POSTGRES_USER=projectecho
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-a-local-redis-password
REDIS_PORT=6379

KAFKA_EXTERNAL_PORT=9094
KAFKA_NUM_PARTITIONS=3
KAFKA_UI_PORT=8080

PGADMIN_DEFAULT_EMAIL=admin@projectecho.local
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-pgadmin-password
PGADMIN_PORT=5050

# ── JWT Signing Secret (SEC-01 / ADR-006) ──────────────────────────────────────
# Required. Minimum 32-character (256-bit) random string. Generate with:
#   openssl rand -base64 64
# Never commit a real secret here. This value must be set in your local .env file
# and injected as an environment variable in all deployment targets.
JWT_SECRET=replace-with-a-minimum-32-character-random-secret-generated-by-openssl-rand-base64-64
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=project-echo
