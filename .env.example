# -----------------------------------------------------------------------------
# ProjectEcho Production Environment Template
# Copy this file to .env and configure actual secrets before launching.
# -----------------------------------------------------------------------------

# PostgreSQL Configuration
POSTGRES_DB=project_echo
POSTGRES_USER=echo
POSTGRES_PASSWORD=echo_password
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Spring Boot Data Sources
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/project_echo
SPRING_DATASOURCE_USERNAME=echo
SPRING_DATASOURCE_PASSWORD=echo_password
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Security Configuration
# Ensure the secret is a Base64-encoded string of at least 256 bits (32 bytes)
JWT_SECRET=dGhpcy1pcy1hLXNlY3JldC1rZXktZm9yLXRlc3RpbmctcHVycG9zZXMtcGxlYXNlLWNoYW5nZS1pdC1pbi1wcm9kdWN0aW9uCg==

# Observability Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
